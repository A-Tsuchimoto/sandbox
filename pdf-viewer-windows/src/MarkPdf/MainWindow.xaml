<Window x:Class="MarkPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkPdf"
        Title="MarkPDF"
        Width="1100" Height="820" MinWidth="560" MinHeight="400"
        AllowDrop="True"
        Background="#E3E5E8"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">
    <DockPanel>
        <!-- ツールバー（狭いウィンドウでは折り返す） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="BtnOpen" Style="{StaticResource BarButton}" ToolTip="PDFを開く (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" />
                            <TextBlock Text="開く" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource BarButton}" ToolTip="ハイライト付きで保存 (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" />
                            <TextBlock Text="保存" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Sep}" />
                    <ToggleButton x:Name="BtnPen" Style="{StaticResource BarToggle}" ToolTip="マーカー (P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" />
                            <TextBlock Text="マーカー" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnEraser" Style="{StaticResource BarToggle}" ToolTip="消しゴム (E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE75C;" />
                            <TextBlock Text="消しゴム" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="BtnUndo" Style="{StaticResource BarButton}" ToolTip="元に戻す (Ctrl+Z)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
                    </Button>
                    <Border Style="{StaticResource Sep}" />
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="BtnWidth" Style="{StaticResource BarButton}" ToolTip="線の太さ (W)" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="4,0" />
                    <ToggleButton x:Name="BtnSnap" Style="{StaticResource BarToggle}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                  ToolTip="文字吸着：近くの文字の行の中央に線を合わせる (T)" Content="文字吸着" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnZoomOut" Style="{StaticResource BarButton}" ToolTip="縮小 (Ctrl+-)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" />
                    </Button>
                    <Button x:Name="BtnZoom" Style="{StaticResource BarButton}" ToolTip="100% に戻す (Ctrl+0)" MinWidth="56" Content="100%" />
                    <Button x:Name="BtnZoomIn" Style="{StaticResource BarButton}" ToolTip="拡大 (Ctrl++)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" />
                    </Button>
                    <Border Style="{StaticResource Sep}" />
                    <Button x:Name="BtnMore" Style="{StaticResource BarButton}" ToolTip="その他">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="PageText" DockPanel.Dock="Right" Foreground="#5F6368" />
                <TextBlock x:Name="HintText" Foreground="#5F6368" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer x:Name="Scroller" CanContentScroll="True" Focusable="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <local:DocumentView x:Name="Doc" />
            </ScrollViewer>

            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnOpenBig" Padding="28,12" Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource Primary}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="PDFを開く" Foreground="White" FontSize="16" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="またはここに PDF をドラッグ＆ドロップ" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="#5F6368" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

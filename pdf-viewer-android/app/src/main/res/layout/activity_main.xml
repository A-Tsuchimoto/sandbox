<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- 上部バー：開く / タイトル / ツール -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/btnSave"
            style="@style/ToolButton"
            android:contentDescription="@string/save"
            android:src="@drawable/ic_save" />

        <ImageButton
            android:id="@+id/btnPen"
            style="@style/ToolButton"
            android:contentDescription="@string/tool_pen"
            android:src="@drawable/ic_marker" />

        <ImageButton
            android:id="@+id/btnEraser"
            style="@style/ToolButton"
            android:contentDescription="@string/tool_eraser"
            android:src="@drawable/ic_eraser" />

        <ImageButton
            android:id="@+id/btnUndo"
            style="@style/ToolButton"
            android:contentDescription="@string/undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/ToolButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <app.markpdf.ui.PageListView
            android:id="@+id/pageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical|horizontal" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_open_button"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/open_pdf"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- ズーム：− 倍率 ＋（倍率をタップで等倍） -->
        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_zoom"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnZoomOut"
                style="@style/ZoomButton"
                android:contentDescription="@string/zoom_out"
                android:text="−" />

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/zoom_reset"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnZoomIn"
                style="@style/ZoomButton"
                android:contentDescription="@string/zoom_in"
                android:text="＋" />
        </LinearLayout>

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
        <!-- 編集中の移動用アナログパッド（左手で操作、右手でなぞる想定） -->
        <app.markpdf.ui.JoystickView
            android:id="@+id/joystick"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:contentDescription="@string/joystick"
            android:visibility="gone" />
    </FrameLayout>

    <!-- マーカーモード時のパレット -->
    <LinearLayout
        android:id="@+id/penBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/swatches"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnSnap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/text_snap"
            android:textColor="@color/chip_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnWidth"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_width_button"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
